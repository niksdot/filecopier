<Application x:Class="FileCopier.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FileCopier"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ==================================================================
                 LIGHT PALETTE
                 Every brush below is looked up with DynamicResource, so the
                 dark palette can be swapped in at runtime (see ApplyTheme).
                 ================================================================== -->

            <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FDFEFF" Offset="0"/>
                <GradientStop Color="#EEF3FC" Offset="0.55"/>
                <GradientStop Color="#E1E9F9" Offset="1"/>
            </LinearGradientBrush>

            <!-- ambient background orbs (soft radial glows behind the card) -->
            <RadialGradientBrush x:Key="Orb1Brush">
                <GradientStop Color="#596366F1" Offset="0"/>
                <GradientStop Color="#006366F1" Offset="1"/>
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="Orb2Brush">
                <GradientStop Color="#4CD946EF" Offset="0"/>
                <GradientStop Color="#00D946EF" Offset="1"/>
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="Orb3Brush">
                <GradientStop Color="#4638BDF8" Offset="0"/>
                <GradientStop Color="#0038BDF8" Offset="1"/>
            </RadialGradientBrush>

            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardBorderBrush" Color="#E4EAF6"/>
            <SolidColorBrush x:Key="DividerBrush" Color="#EFF2F9"/>

            <!-- soft sheen across the top of the card / buttons -->
            <LinearGradientBrush x:Key="CardGlossBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#59FFFFFF" Offset="0"/>
                <GradientStop Color="#00FFFFFF" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ButtonGlossBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#59FFFFFF" Offset="0"/>
                <GradientStop Color="#00FFFFFF" Offset="1"/>
            </LinearGradientBrush>

            <!-- gradient title text -->
            <LinearGradientBrush x:Key="TitleGradientBrush" StartPoint="0,0" EndPoint="1,0.35">
                <GradientStop Color="#4338CA" Offset="0"/>
                <GradientStop Color="#7C3AED" Offset="0.55"/>
                <GradientStop Color="#C026D3" Offset="1"/>
            </LinearGradientBrush>

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B"/>

            <SolidColorBrush x:Key="InputBrush" Color="#F5F7FC"/>
            <SolidColorBrush x:Key="InputBorderBrush" Color="#E2E8F3"/>
            <SolidColorBrush x:Key="FocusBorderBrush" Color="#6366F1"/>
            <SolidColorBrush x:Key="InputIconTintBrush" Color="#ECF0FD"/>
            <SolidColorBrush x:Key="InputIconBrush" Color="#6366F1"/>

            <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#6366F1" Offset="0"/>
                <GradientStop Color="#8B5CF6" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AccentHoverBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#7A7CF7" Offset="0"/>
                <GradientStop Color="#9F71FF" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AccentPressedBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#4F46E5" Offset="0"/>
                <GradientStop Color="#7C3AED" Offset="1"/>
            </LinearGradientBrush>

            <!-- primary action: rich three-stop gradient -->
            <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#6366F1" Offset="0"/>
                <GradientStop Color="#8B5CF6" Offset="0.5"/>
                <GradientStop Color="#D946EF" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PrimaryHoverBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#7A7CF7" Offset="0"/>
                <GradientStop Color="#9D74F9" Offset="0.5"/>
                <GradientStop Color="#E05FF3" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PrimaryPressedBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#4F46E5" Offset="0"/>
                <GradientStop Color="#7C3AED" Offset="0.5"/>
                <GradientStop Color="#C026D3" Offset="1"/>
            </LinearGradientBrush>

            <!-- soft tinted secondary buttons -->
            <SolidColorBrush x:Key="TintBrush" Color="#EEF2FF"/>
            <SolidColorBrush x:Key="TintHoverBrush" Color="#E0E7FF"/>
            <SolidColorBrush x:Key="TintPressedBrush" Color="#C7D2FE"/>
            <SolidColorBrush x:Key="TintTextBrush" Color="#4F46E5"/>

            <LinearGradientBrush x:Key="SuccessBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#10B981" Offset="0"/>
                <GradientStop Color="#059669" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SuccessHoverBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#25C795" Offset="0"/>
                <GradientStop Color="#0AA874" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SuccessPressedBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#059669" Offset="0"/>
                <GradientStop Color="#047857" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="NeutralBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F1F4FB" Offset="0"/>
                <GradientStop Color="#E4EAF6" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="NeutralHoverBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E8EDF8" Offset="0"/>
                <GradientStop Color="#DAE2F1" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="NeutralPressedBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#DAE2F1" Offset="0"/>
                <GradientStop Color="#C9D4E8" Offset="1"/>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="NeutralTextBrush" Color="#334155"/>

            <SolidColorBrush x:Key="SegmentTrackBrush" Color="#EDF1F9"/>
            <SolidColorBrush x:Key="SegmentHoverBrush" Color="#E1E8F5"/>
            <SolidColorBrush x:Key="SegmentActiveBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SegmentTextBrush" Color="#64748B"/>
            <SolidColorBrush x:Key="SegmentActiveTextBrush" Color="#4F46E5"/>

            <SolidColorBrush x:Key="ProgressTrackBrush" Color="#E9EEF8"/>
            <SolidColorBrush x:Key="SuccessTextBrush" Color="#059669"/>
            <SolidColorBrush x:Key="ErrorTextBrush" Color="#DC2626"/>
            <SolidColorBrush x:Key="InfoTextBrush" Color="#4F46E5"/>

            <SolidColorBrush x:Key="SuccessTintBrush" Color="#ECFDF5"/>
            <SolidColorBrush x:Key="SuccessBorderBrush" Color="#A7F3D0"/>
            <SolidColorBrush x:Key="ErrorTintBrush" Color="#FEF2F2"/>
            <SolidColorBrush x:Key="ErrorBorderBrush" Color="#FECACA"/>
            <SolidColorBrush x:Key="InfoTintBrush" Color="#EEF2FF"/>
            <SolidColorBrush x:Key="InfoBorderBrush" Color="#C7D2FE"/>

            <SolidColorBrush x:Key="WindowButtonHoverBrush" Color="#E8EDF7"/>
            <SolidColorBrush x:Key="WindowButtonPressedBrush" Color="#DAE2F2"/>
            <SolidColorBrush x:Key="CloseHoverBrush" Color="#EF4444"/>
            <SolidColorBrush x:Key="ClosePressedBrush" Color="#DC2626"/>
            <SolidColorBrush x:Key="WindowButtonGlyphBrush" Color="#475569"/>
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

            <!-- ==================================================================
                 GLOWS  (cast by a shadow layer placed behind each button/card so
                 that label text keeps crisp ClearType rendering)
                 ================================================================== -->
            <DropShadowEffect x:Key="GlowAccent" Color="#6366F1" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.34"/>
            <DropShadowEffect x:Key="GlowPrimary" Color="#B855F7" BlurRadius="18" ShadowDepth="5" Direction="270" Opacity="0.42"/>
            <DropShadowEffect x:Key="GlowSuccess" Color="#10B981" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.34"/>
            <DropShadowEffect x:Key="GlowNeutral" Color="#8FA0BC" BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.26"/>
            <DropShadowEffect x:Key="GlowTint" Color="#818CF8" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.2"/>

            <!-- ==================================================================
                 BUTTONS  (pill-shaped, glossy, with coloured glow)
                 ================================================================== -->
            <ControlTemplate x:Key="PillButtonTemplate" TargetType="Button">
                <Grid>
                    <!-- shadow layer: fully occluded by the real surface, only its
                         blurred glow stays visible -->
                    <Border CornerRadius="22"
                            Background="{TemplateBinding Background}"
                            Effect="{Binding Path=(local:Effects.Glow), RelativeSource={RelativeSource TemplatedParent}}"/>
                    <Border x:Name="Bd" CornerRadius="22"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Border.RenderTransform>
                        <Grid>
                            <!-- glossy highlight along the top edge -->
                            <Border Height="30" CornerRadius="22" VerticalAlignment="Top"
                                    Background="{StaticResource ButtonGlossBrush}"
                                    IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                    </Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Bd" Property="RenderTransform">
                            <Setter.Value>
                                <TranslateTransform Y="1"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="BaseButtonStyle" TargetType="Button">
                <Setter Property="Template" Value="{StaticResource PillButtonTemplate}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="22,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="local:Effects.Glow" Value="{StaticResource GlowAccent}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                <Setter Property="local:Effects.Glow" Value="{StaticResource GlowPrimary}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="TintButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource TintBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TintTextBrush}"/>
                <Setter Property="local:Effects.Glow" Value="{StaticResource GlowTint}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource TintHoverBrush}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource TintPressedBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                <Setter Property="local:Effects.Glow" Value="{StaticResource GlowSuccess}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SuccessHoverBrush}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SuccessPressedBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="NeutralButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource NeutralBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource NeutralTextBrush}"/>
                <Setter Property="local:Effects.Glow" Value="{StaticResource GlowNeutral}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource NeutralHoverBrush}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource NeutralPressedBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- window caption buttons -->
            <ControlTemplate x:Key="WindowButtonTemplate" TargetType="Button">
                <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>

            <Style x:Key="WindowButtonStyle" TargetType="Button">
                <Setter Property="Template" Value="{StaticResource WindowButtonTemplate}"/>
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource WindowButtonGlyphBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource WindowButtonHoverBrush}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource WindowButtonPressedBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CloseWindowButtonStyle" TargetType="Button">
                <Setter Property="Template" Value="{StaticResource WindowButtonTemplate}"/>
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource WindowButtonGlyphBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource CloseHoverBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ClosePressedBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ==================================================================
                 SEGMENTED TOGGLE  (language / theme switch in the title bar)
                 ================================================================== -->
            <Style x:Key="SegmentToggleStyle" TargetType="ToggleButton">
                <Setter Property="Height" Value="30"/>
                <Setter Property="MinWidth" Value="38"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Foreground" Value="{DynamicResource SegmentTextBrush}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" CornerRadius="8" Background="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SegmentHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SegmentActiveBrush}"/>
                                    <Setter TargetName="Bd" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#0F172A" BlurRadius="8" ShadowDepth="1"
                                                              Direction="270" Opacity="0.16"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Foreground" Value="{DynamicResource SegmentActiveTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ==================================================================
                 TEXT BOX  (read-only path fields, with focus ring)
                 ================================================================== -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource FocusBorderBrush}"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd" CornerRadius="14"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1.2">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/>
                                    <Setter TargetName="Bd" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#6366F1" BlurRadius="12" ShadowDepth="0" Opacity="0.38"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ==================================================================
                 PROGRESS BAR  (rounded track + sweeping gradient bar)
                 ================================================================== -->
            <Style TargetType="ProgressBar">
                <Setter Property="Height" Value="6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border CornerRadius="4" Background="{DynamicResource ProgressTrackBrush}" ClipToBounds="True">
                                <Grid>
                                    <Rectangle x:Name="PART_Track"/>
                                    <Border x:Name="PART_Indicator" Width="170" HorizontalAlignment="Left"
                                            CornerRadius="4" Background="{DynamicResource PrimaryBrush}"
                                            Opacity="0" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="IndicatorShift" X="-170"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsIndeterminate" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard x:Name="IndeterminateGlow">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="PART_Indicator"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.01"/>
                                                <DoubleAnimation Storyboard.TargetName="IndicatorShift"
                                                                 Storyboard.TargetProperty="X"
                                                                 From="-170" To="780" Duration="0:0:1.9">
                                                    <DoubleAnimation.EasingFunction>
                                                        <SineEase EasingMode="EaseInOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="IndeterminateGlow"/>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ==================================================================
                 TOOL TIP
                 ================================================================== -->
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Padding" Value="9,5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border CornerRadius="8" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
