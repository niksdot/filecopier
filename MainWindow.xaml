<Window x:Class="FileCopier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:FileCopier"
        mc:Ignorable="d"
        Title="File Copier"
        Width="740" Height="640"
        MinWidth="620" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        StateChanged="Window_StateChanged"
        Loaded="Window_Loaded">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="54"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootSurface" Background="{DynamicResource WindowBackgroundBrush}"
            TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
            Opacity="0">
        <Grid>
            <!-- ======================= AMBIENT ORBS ======================= -->
            <Grid IsHitTestVisible="False">
                <Ellipse Width="540" Height="540" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-170,-190,0,0" Fill="{DynamicResource Orb1Brush}"/>
                <Ellipse Width="500" Height="500" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-160,-180" Fill="{DynamicResource Orb2Brush}"/>
                <Ellipse Width="360" Height="360" HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,-150,-90,0" Fill="{DynamicResource Orb3Brush}" Opacity="0.75"/>
            </Grid>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ======================= TITLE BAR ======================= -->
                <Grid Grid.Row="0" Height="54" Margin="12,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                        <Border Width="30" Height="30" CornerRadius="10" Background="{DynamicResource AccentBrush}">
                            <Border.Effect>
                                <DropShadowEffect Color="#8B5CF6" BlurRadius="14" ShadowDepth="2"
                                                  Direction="270" Opacity="0.5"/>
                            </Border.Effect>
                            <Canvas Width="20" Height="20">
                                <!-- back sheet -->
                                <Path Stroke="#FFFFFF" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M7.4,6.6 V4 A2,2 0 0 1 9.4,2 H14.5 A2,2 0 0 1 16.5,4 V9.1 A2,2 0 0 1 14.5,11.1 H13.6"/>
                                <!-- front sheet -->
                                <Path Stroke="#FFFFFF" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M4.4,6.6 H11.4 A2.2,2.2 0 0 1 13.6,8.8 V15.4 A2.2,2.2 0 0 1 11.4,17.6 H4.4 A2.2,2.2 0 0 1 2.2,15.4 V8.8 A2.2,2.2 0 0 1 4.4,6.6 Z"/>
                            </Canvas>
                        </Border>
                        <TextBlock x:Name="TitleBarText" Text="File Copier" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="11,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                        <!-- language switch -->
                        <Border Background="{DynamicResource SegmentTrackBrush}" CornerRadius="11" Padding="3"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="LangEnBtn" Style="{StaticResource SegmentToggleStyle}"
                                              Content="EN" Click="SetEnglish_Click"
                                              shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                                <ToggleButton x:Name="LangRuBtn" Style="{StaticResource SegmentToggleStyle}"
                                              Content="РУ" Click="SetRussian_Click"
                                              shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                            </StackPanel>
                        </Border>

                        <!-- theme switch -->
                        <Border Background="{DynamicResource SegmentTrackBrush}" CornerRadius="11" Padding="3"
                                Margin="8,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="LightThemeBtn" Style="{StaticResource SegmentToggleStyle}"
                                              Click="SetLightTheme_Click"
                                              shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid Width="14" Height="14">
                                        <Ellipse Width="6.6" Height="6.6" StrokeThickness="1.3"
                                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                        <Path StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                              Data="M7,0.7 V2.5 M7,11.5 V13.3 M0.7,7 H2.5 M11.5,7 H13.3 M2.5,2.5 L3.8,3.8 M10.2,10.2 L11.5,11.5 M11.5,2.5 L10.2,3.8 M3.8,10.2 L2.5,11.5"/>
                                    </Grid>
                                </ToggleButton>
                                <ToggleButton x:Name="DarkThemeBtn" Style="{StaticResource SegmentToggleStyle}"
                                              Click="SetDarkTheme_Click"
                                              shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="0"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          Data="M7.8,0.6 A5.6,5.6 0 1 0 11.6,8.9 A4.6,4.6 0 0 1 7.8,0.6 Z"/>
                                </ToggleButton>
                            </StackPanel>
                        </Border>

                        <!-- window buttons -->
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                            <Button x:Name="MinimizeBtn" Style="{StaticResource WindowButtonStyle}"
                                    Click="Minimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <Grid Width="11" Height="11">
                                    <Path StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M0.5,5.5 H10.5"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Grid>
                            </Button>
                            <Button x:Name="MaximizeBtn" Style="{StaticResource WindowButtonStyle}"
                                    Click="Maximize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <Grid Width="11" Height="11">
                                    <Path x:Name="MaxIcon" StrokeThickness="1.2" StrokeLineJoin="Round"
                                          Data="M0.6,0.6 H10.4 V10.4 H0.6 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <Path x:Name="RestoreIcon" StrokeThickness="1.2" StrokeLineJoin="Round"
                                          Visibility="Collapsed"
                                          Data="M2.6,0.6 H10.4 V8.4 M0.6,2.6 H8.4 V10.4 H0.6 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Grid>
                            </Button>
                            <Button x:Name="CloseBtn" Style="{StaticResource CloseWindowButtonStyle}"
                                    Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <Grid Width="11" Height="11">
                                    <Path StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M0.7,0.7 L10.3,10.3 M10.3,0.7 L0.7,10.3"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ======================= FLOATING CARD ======================= -->
                <Grid Grid.Row="1" x:Name="CardLayer" Margin="26,6,26,28">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="CardShift" Y="30"/>
                    </Grid.RenderTransform>

                    <!-- shadow layer: hidden behind the card, only its glow is visible -->
                    <Border x:Name="CardShadow" CornerRadius="24"
                            Background="{DynamicResource CardBackgroundBrush}">
                        <Border.Effect>
                            <DropShadowEffect Color="#0B1220" BlurRadius="44" ShadowDepth="14"
                                              Direction="270" Opacity="0.2"/>
                        </Border.Effect>
                    </Border>

                    <Border x:Name="Card" CornerRadius="24"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <!-- soft sheen across the top of the card -->
                            <Border Height="150" CornerRadius="23,23,0,0" VerticalAlignment="Top"
                                    Background="{DynamicResource CardGlossBrush}" IsHitTestVisible="False"/>

                            <StackPanel VerticalAlignment="Center" Margin="36,32,36,32">

                                <TextBlock x:Name="TitleText" Text="File Copier" FontSize="28" FontWeight="Bold"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource TitleGradientBrush}"/>
                                <TextBlock x:Name="SubtitleText" Text="Fast and safe file copying" FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>

                                <!-- source file -->
                                <TextBlock x:Name="SelectFileLabel" Text="Select file to copy:" FontSize="12.5"
                                           FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="3,30,0,8"/>
                                <Grid>
                                    <TextBox x:Name="txtFilePath" IsReadOnly="True" Padding="46,0,126,0"/>
                                    <Border Width="28" Height="28" CornerRadius="9" HorizontalAlignment="Left"
                                            Margin="9,0,0,0" Background="{DynamicResource InputIconTintBrush}"
                                            IsHitTestVisible="False">
                                        <Path Width="15" Height="15" Stretch="Uniform"
                                              Stroke="{DynamicResource InputIconBrush}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M5,1.5 H9.5 L12.5,4.5 V13 A1.5,1.5 0 0 1 11,14.5 H5 A1.5,1.5 0 0 1 3.5,13 V3 A1.5,1.5 0 0 1 5,1.5 Z M9.5,1.5 V3.5 A1,1 0 0 0 10.5,4.5 H12.5"/>
                                    </Border>
                                    <Button x:Name="BrowseFileBtn" HorizontalAlignment="Right"
                                            Style="{StaticResource TintButtonStyle}"
                                            Height="34" MinWidth="112" Padding="16,0"
                                            Click="BtnSelectFile_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="14" Height="14" Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M2,5.2 A1.6,1.6 0 0 1 3.6,3.6 H6.3 A1.2,1.2 0 0 1 7.2,4 L8.1,4.8 H12.4 A1.6,1.6 0 0 1 14,6.4 V11.8 A1.6,1.6 0 0 1 12.4,13.4 H3.6 A1.6,1.6 0 0 1 2,11.8 Z"/>
                                            <TextBlock x:Name="BrowseFileText" Text="Browse..." Margin="7,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- destination folder -->
                                <TextBlock x:Name="SelectFolderLabel" Text="Select destination folder:" FontSize="12.5"
                                           FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="3,22,0,8"/>
                                <Grid>
                                    <TextBox x:Name="txtFolderPath" IsReadOnly="True" Padding="46,0,126,0"/>
                                    <Border Width="28" Height="28" CornerRadius="9" HorizontalAlignment="Left"
                                            Margin="9,0,0,0" Background="{DynamicResource InputIconTintBrush}"
                                            IsHitTestVisible="False">
                                        <Path Width="15" Height="15" Stretch="Uniform"
                                              Stroke="{DynamicResource InputIconBrush}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M2,5.2 A1.6,1.6 0 0 1 3.6,3.6 H6.3 A1.2,1.2 0 0 1 7.2,4 L8.1,4.8 H12.4 A1.6,1.6 0 0 1 14,6.4 V11.8 A1.6,1.6 0 0 1 12.4,13.4 H3.6 A1.6,1.6 0 0 1 2,11.8 Z"/>
                                    </Border>
                                    <Button x:Name="BrowseFolderBtn" HorizontalAlignment="Right"
                                            Style="{StaticResource TintButtonStyle}"
                                            Height="34" MinWidth="112" Padding="16,0"
                                            Click="BtnSelectFolder_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="14" Height="14" Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M2,5.2 A1.6,1.6 0 0 1 3.6,3.6 H6.3 A1.2,1.2 0 0 1 7.2,4 L8.1,4.8 H12.4 A1.6,1.6 0 0 1 14,6.4 V11.8 A1.6,1.6 0 0 1 12.4,13.4 H3.6 A1.6,1.6 0 0 1 2,11.8 Z"/>
                                            <TextBlock x:Name="BrowseFolderText" Text="Browse..." Margin="7,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- actions -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
                                    <Button x:Name="CopyBtn" Style="{StaticResource PrimaryButtonStyle}"
                                            Height="50" MinWidth="192" FontSize="14.5" Click="BtnCopy_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="17" Height="17" Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M6.6,6 V4 A2,2 0 0 1 8.6,2 H12.4 A2,2 0 0 1 14.4,4 V9.4 A2,2 0 0 1 12.4,11.4 H11.6 M4.4,6 H10 A2,2 0 0 1 12,8 V13.6 A2,2 0 0 1 10,15.6 H4.4 A2,2 0 0 1 2.4,13.6 V8 A2,2 0 0 1 4.4,6 Z"/>
                                            <TextBlock x:Name="CopyText" Text="Copy" Margin="9,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ClearBtn" Style="{StaticResource NeutralButtonStyle}"
                                            Height="50" MinWidth="132" FontSize="14.5" Margin="12,0,0,0"
                                            Click="BtnClear_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="13" Height="13" Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M3.4,3.4 L12.6,12.6 M12.6,3.4 L3.4,12.6"/>
                                            <TextBlock x:Name="ClearText" Text="Clear" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- progress (space is always reserved to avoid layout jumps) -->
                                <Grid Height="6" Margin="0,28,0,0">
                                    <ProgressBar x:Name="progressBar" IsIndeterminate="True" Visibility="Collapsed"/>
                                </Grid>

                                <!-- status message -->
                                <Grid MinHeight="48" Margin="0,20,0,0">
                                    <Border x:Name="StatusPanel" CornerRadius="14" Padding="14,11" Visibility="Collapsed"
                                            Background="{DynamicResource SuccessTintBrush}"
                                            BorderBrush="{DynamicResource SuccessBorderBrush}"
                                            BorderThickness="1">
                                        <TextBlock x:Name="statusText" TextAlignment="Center" FontSize="12.5"
                                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
